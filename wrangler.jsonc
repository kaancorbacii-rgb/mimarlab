{
  "name": "mimarlab",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mimarlab-db",
      "database_id": "65856ee8-f2a3-4461-867d-3ed7faf2c246"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "mimarlab-uploads"
    }
  ],
  // Faz 3 — facet_counts hızlı okuma önbelleği (bkz. src/lib/facetCounts.js, migrations/
  // 0024_facet_counts.sql). Gerçek Cloudflare KV namespace'i (`wrangler kv namespace create
  // FACET_CACHE` ile oluşturuldu, bkz. docs/architecture-roadmap.md). Yerel `wrangler dev`
  // (--local, varsayılan) bu id'yi gerçek API'ye dokunmadan yerel olarak simüle eder.
  "kv_namespaces": [
    {
      "binding": "FACET_CACHE",
      "id": "9a8a1cfde13447a498bc5dcc4bc7d4ae"
    }
  ],
  "vars": {
    // iyzico Sandbox test ortamı — canlıya alırken "https://api.iyzipay.com" olarak değiştirilmeli.
    // Gizli anahtarlar (IYZICO_API_KEY, IYZICO_SECRET_KEY, RESEND_API_KEY) burada değil, `wrangler
    // secret put` ile ayrı ayrı tanımlanır.
    //
    // Google/LinkedIn Sosyal Giriş (bkz. src/lib/oauth.js, kullanıcı isteği) — GOOGLE_CLIENT_ID/
    // GOOGLE_CLIENT_SECRET (Google Cloud Console > OAuth 2.0 istemci, yetkilendirilmiş yönlendirme
    // URI'si: https://mimarlab.com/api/auth/google/callback) ve LINKEDIN_CLIENT_ID/
    // LINKEDIN_CLIENT_SECRET (LinkedIn Developer Portal > "Sign In with LinkedIn using OpenID
    // Connect" ürünü eklenmiş bir uygulama, yönlendirme URI'si: https://mimarlab.com/api/auth/
    // linkedin/callback) de AYNI şekilde `wrangler secret put` ile tanımlanmalı. Tanımlı değilse
    // ilgili "... ile Giriş Yap" butonu tıklandığında sessizce giris-yap.html?oauth_error=not_
    // configured'a yönlendirir — mevcut e-posta/şifre akışı bundan ETKİLENMEZ.
    "IYZICO_BASE_URL": "https://sandbox-api.iyzipay.com"
  }
}
